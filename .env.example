# --- LLM used by the agent (any LangChain init_chat_model spec) ---------------------
FLOWMAPPER_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=...          # with FLOWMAPPER_MODEL=openai:gpt-5 (pip install langchain-openai)

# --- Files loaded at startup (comma separated) ---------------------------------------
# FLOWMAPPER_FILES=exports/explorer_export.csv,exports/syslog.log

# --- Graph tuning ---------------------------------------------------------------------
# FLOWMAPPER_GROUP_BY=app,env            # Illumio labels defining an application (default app,env)
# FLOWMAPPER_UNMANAGED_GROUPING=iplist   # iplist | subnet | ip
# FLOWMAPPER_SHARED_MIN_CONSUMERS=3      # apps consuming a node before it is flagged "shared"
# FLOWMAPPER_SUBNET_PREFIX=24
# FLOWMAPPER_ATTACH_UNMANAGED=true       # attach VEN-less IPs to the only app using them
# FLOWMAPPER_IP_LISTS={"Internet":["0.0.0.0/0"],"Corporate Users":["10.200.0.0/16"]}   # JSON or path to a JSON file; first match wins

# --- PCE access for `flowmapper fetch` and POST /api/ingest/pce ----------------------
# ILLUMIO_PCE_URL=https://pce.corp.example:8443
# ILLUMIO_ORG_ID=1
# ILLUMIO_API_KEY=api_xxxxxxxxxxxxxxxxx
# ILLUMIO_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ILLUMIO_VERIFY_SSL=true                # or /path/to/ca-bundle.pem

# --- AI enrichment ---------------------------------------------------------------------
# FLOWMAPPER_AUTO_ENRICH=true            # run the enrichment after each ingest
# FLOWMAPPER_AUTO_APPLY=false            # apply proposals automatically (HITL off) — not recommended
# FLOWMAPPER_LANGUAGE=en                 # language of proposal rationales / labels
